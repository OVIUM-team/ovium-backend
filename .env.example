# Configura estos valores cuando habilites la base de datos y la autenticación.
# Ejemplo local dentro de Compose. Codifica la contraseña para URL.
# DATABASE_URL='mssql+pyodbc://sa:TU_CLAVE_CODIFICADA@db:1433/master?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes'
# JWT_SECRET=
# Orígenes web autorizados, como lista JSON.
CORS_ORIGINS=["http://localhost:5173"]

# Solo para Docker Compose. Define una contraseña local de SQL Server.
MSSQL_SA_PASSWORD=
